[
 {
  "id": "fold-elbow-raised",
  "bug": "Folded elbow pushed up off the back by the IK pole; wings stuck up like ears (2026-11-01).",
  "tests": [
   "test_bird_rig"
  ],
  "edits": [
   {
    "file": "scripts/bird/bird_rig.gd",
    "find": "\t\tvar pole := el_fk.lerp(fold_elbow[i], ik_w)",
    "replace": "\t\tvar pole := el_fk.lerp(sh + Vector3(s * 0.1, 0.35, 1.0) * _L, ik_w)"
   },
   {
    "file": "scripts/bird/bird_rig.gd",
    "find": "\t\tfold_anchor[i] = wrist\n",
    "replace": "\t\tfold_anchor[i] = sh + Vector3(s * maxf(_L * 0.155 - shape.shoulder.x, 0.0), 0.0, 0.0) + Vector3(0.0, -0.75, 0.66).normalized() * maxf(absf(l[0] - l[1]) * 1.15, _L * 0.07)\n"
   }
  ]
 },
